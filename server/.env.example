# =====================================================================
# QUESTFORGE AI - BACKEND ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env in this directory (server/.env) and fill in your keys.
# The server will automatically detect and configure providers based on keys provided.
# If no keys are provided, the platform runs in High-Fidelity Deterministic Demo Mode.
# =====================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------
# MULTI-PROVIDER AI CONFIGURATION
# ---------------------------------------------------------------------
# Primary selection and failover controls:
# AI_PRIMARY_PROVIDER: 'gemini' | 'groq' | 'nvidia'
AI_PRIMARY_PROVIDER=gemini
AI_FAILOVER_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# --- PROVIDER 1: GOOGLE GEMINI ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- PROVIDER 2: GROQ CLOUD ---
# Obtain from: https://console.groq.com/keys
# Supported models: openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- PROVIDER 3: NVIDIA NeMoTron 3 Ultra (NVIDIA NIM) ---
# Obtain from: https://build.nvidia.com/
# NVIDIA NIM API uses OpenAI-compatible format with Bearer token authentication.
# Configured model identifier:
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ---------------------------------------------------------------------
# STORAGE & DATABASE CONFIGURATION (Optional)
# ---------------------------------------------------------------------
# If unconfigured, the application runs with in-memory session persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# FILE UPLOAD CONSTRAINTS
# ---------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
